diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index c2826fc..e2b0d54 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -3117,6 +3117,95 @@ static int ggml_cpu_try_fuse_ops(
     return 0;
 }
 
+#ifdef GGML_OP_PROFILE
+// LDLS_Project_1: per-operator wall-clock profiler (perf is unavailable on the node,
+// perf_event_paranoid=3). Enabled at runtime with GGML_OP_PROFILE=<out.csv>.
+// Thread 0 timestamps each node before compute and again after the barrier that
+// follows it, so "total" = slowest thread incl. barrier wait, "own" = thread 0 compute.
+// Graphs are classified as decode (n_tokens == 1) or prefill (n_tokens > 1).
+#define OPPROF_MAX 8192
+struct opprof_entry { char phase; char op[32]; char name[64]; int64_t n; double t_total; double t_own; };
+static struct opprof_entry opprof_tab[OPPROF_MAX];
+static int     opprof_n       = 0;
+static int     opprof_enabled = -1;
+static char    opprof_path[512];
+static int64_t opprof_graphs[2];
+static int64_t opprof_tokens[2];
+static double  opprof_graph_t[2];
+
+static double opprof_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double) ts.tv_sec * 1e9 + (double) ts.tv_nsec;
+}
+
+static void opprof_dump(void) {
+    FILE * f = fopen(opprof_path, "w");
+    if (!f) {
+        return;
+    }
+    fprintf(f, "phase,op,name,count,total_ms,own_ms\n");
+    for (int i = 0; i < opprof_n; i++) {
+        const struct opprof_entry * e = &opprof_tab[i];
+        fprintf(f, "%s,%s,%s,%" PRId64 ",%.6f,%.6f\n", e->phase == 'D' ? "decode" : "prefill",
+                e->op, e->name, e->n, e->t_total * 1e-6, e->t_own * 1e-6);
+    }
+    for (int p = 0; p < 2; p++) {
+        fprintf(f, "%s,__GRAPH__,graphs=%" PRId64 ";tokens=%" PRId64 ",%" PRId64 ",%.6f,0\n",
+                p ? "decode" : "prefill", opprof_graphs[p], opprof_tokens[p], opprof_graphs[p], opprof_graph_t[p] * 1e-6);
+    }
+    fclose(f);
+}
+
+static int opprof_on(void) {
+    if (opprof_enabled < 0) {
+        const char * p = getenv("GGML_OP_PROFILE");
+        opprof_enabled = p && p[0];
+        if (opprof_enabled) {
+            snprintf(opprof_path, sizeof(opprof_path), "%s", p);
+            atexit(opprof_dump);
+        }
+    }
+    return opprof_enabled;
+}
+
+// "ffn_moe_gate-12" -> "ffn_moe_gate", "node_45" -> "node", "x (view)" -> "x"
+static void opprof_strip(const char * in, char * out, size_t n) {
+    size_t j = 0;
+    for (size_t i = 0; in[i] && in[i] != ' ' && j + 1 < n; i++) {
+        out[j++] = in[i];
+    }
+    out[j] = 0;
+    while (j > 0 && out[j-1] >= '0' && out[j-1] <= '9') {
+        out[--j] = 0;
+    }
+    if (j > 0 && (out[j-1] == '-' || out[j-1] == '_')) {
+        out[--j] = 0;
+    }
+}
+
+static void opprof_add(char phase, const struct ggml_tensor * node, int n_fused, double t_total, double t_own) {
+    char op[32];
+    char name[64];
+    snprintf(op, sizeof(op), "%s%s", ggml_op_desc(node), n_fused > 0 ? "+FUSED" : "");
+    opprof_strip(node->name, name, sizeof(name));
+    for (int i = 0; i < opprof_n; i++) {
+        struct opprof_entry * e = &opprof_tab[i];
+        if (e->phase == phase && strcmp(e->op, op) == 0 && strcmp(e->name, name) == 0) {
+            e->n++; e->t_total += t_total; e->t_own += t_own;
+            return;
+        }
+    }
+    if (opprof_n < OPPROF_MAX) {
+        struct opprof_entry * e = &opprof_tab[opprof_n++];
+        e->phase = phase;
+        snprintf(e->op, sizeof(e->op), "%s", op);
+        snprintf(e->name, sizeof(e->name), "%s", name);
+        e->n = 1; e->t_total = t_total; e->t_own = t_own;
+    }
+}
+#endif
+
 static thread_ret_t ggml_graph_compute_thread(void * data) {
     struct ggml_compute_state * state = (struct ggml_compute_state *) data;
     struct ggml_threadpool    * tp    = state->threadpool;
@@ -3145,6 +3234,17 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-start cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
+#ifdef GGML_OP_PROFILE
+    const int prof = state->ith == 0 && opprof_on();
+    // first node of a llama graph is the token-embedding GET_ROWS: ne[1] = n_tokens
+    const int64_t prof_ntok = cgraph->n_nodes > 0 ? cgraph->nodes[0]->ne[1] : 0;
+    const char prof_phase = prof_ntok == 1 ? 'D' : 'P';
+    const double prof_g0 = prof ? opprof_now() : 0.0;
+    const struct ggml_tensor * prof_last = NULL;
+    int    prof_last_fused = 0;
+    double prof_t0 = 0.0, prof_t1 = 0.0;
+#endif
+
     for (int node_n = 0; node_n < cgraph->n_nodes && atomic_load_explicit(&tp->abort, memory_order_relaxed) != node_n; node_n++) {
         struct ggml_tensor * node = cgraph->nodes[node_n];
 
@@ -3157,6 +3257,12 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
             continue;
         }
 
+#ifdef GGML_OP_PROFILE
+        if (prof) {
+            prof_t0 = opprof_now();
+        }
+#endif
+
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
         // Try fused ops, fall back to normal compute
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
@@ -3166,6 +3272,12 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
             ggml_compute_forward(&params, node);
         }
 
+#ifdef GGML_OP_PROFILE
+        if (prof) {
+            prof_t1 = opprof_now();
+        }
+#endif
+
         if (state->ith == 0 && cplan->abort_callback &&
                 cplan->abort_callback(cplan->abort_callback_data)) {
             atomic_store_explicit(&tp->abort, node_n + 1, memory_order_relaxed);
@@ -3174,6 +3286,14 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
 
         if (node_n + 1 < cgraph->n_nodes) {
             ggml_barrier(state->threadpool);
+#ifdef GGML_OP_PROFILE
+            if (prof) {
+                opprof_add(prof_phase, node, n_fused, opprof_now() - prof_t0, prof_t1 - prof_t0);
+            }
+        } else if (prof) {
+            prof_last = node;
+            prof_last_fused = n_fused;
+#endif
         }
     }
 
@@ -3185,6 +3305,19 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
 
     ggml_barrier(state->threadpool);
 
+#ifdef GGML_OP_PROFILE
+    if (prof) {
+        const double now = opprof_now();
+        if (prof_last) {
+            opprof_add(prof_phase, prof_last, prof_last_fused, now - prof_t0, prof_t1 - prof_t0);
+        }
+        const int p = prof_phase == 'D' ? 1 : 0;
+        opprof_graphs[p]  += 1;
+        opprof_tokens[p]  += prof_ntok;
+        opprof_graph_t[p] += now - prof_g0;
+    }
+#endif
+
 #ifdef GGML_USE_CPU_RISCV64_SPACEMIT
     ggml_backend_cpu_riscv64_spacemit_clear_numa_thread_affinity_threaded(state->ith);
 #endif
